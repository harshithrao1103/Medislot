{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassMediSlotLambdaExecutionRolesToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::598886663370:role/medislot-dev-*-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
