{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendDashboardDeploymentCommandToDoctorDashboardInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:598886663370:instance/i-099109e06063828b8",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadDashboardDeploymentCommandResult",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
